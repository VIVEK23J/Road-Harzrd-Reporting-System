# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/roadwatch?retryWrites=true&w=majority

# JWT Authentication Secret Key
JWT_SECRET=your-secure-jwt-secret-key-at-least-32-characters

# Default Admin User Credentials (created automatically on first DB connection)
ADMIN_EMAIL=vivek@gmail.com
ADMIN_PASSWORD=Vivek@1234
